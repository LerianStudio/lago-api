- if subscription?
  - InvoiceSubscriptionsHelper.load_subscriptions_with_fees(self).each do |subscription_with_fees|
    - subscription = subscription_with_fees.subscription
    - invoice_subscription = subscription_with_fees.invoice_subscription
    - filtered_fees = subscription_with_fees.filtered_fees
    - grouped_fees = subscription_with_fees.grouped_fees
    /! lerian:sub
    == SlimHelper.render('templates/invoices/v4/_subscription_name', self, subscription: subscription, page_break: subscriptions.length > 1)

    / Render each billing period group
    - grouped_fees.each_with_index do |fee_group, group_index|
      - next unless fee_group.has_any_fees?
      - billing_period = fee_group.billing_period

      / Billing period section
      .invoice-resume.overflow-auto class="#{'mt-24' if group_index > 0}"
        table.invoice-resume-table width="100%"
          - lerian_recurring = (fee_group.subscription_fee && FeeDisplayHelper.should_display_subscription_fee?(invoice_subscription)) || fee_group.fixed_charge_fees.any?
          - lerian_usage = fee_group.charge_fees.any? || fee_group.commitment_fee.present?
          / Lerian: column heads once, then the billing period as a group row
          - if group_index == 0
            tr.first_child
              td.body-2 = I18n.t('lerian.invoice.charges.description')
              td.body-2 = I18n.t('lerian.invoice.charges.qty')
              td.body-2 = I18n.t('invoice.unit_price')
              td.body-2 = I18n.t('invoice.tax_rate')
              td.body-2 = I18n.t('lerian.invoice.charges.amount', currency:)
          tr.period-row
            td colspan="5"
              span.period-kind = I18n.t('lerian.invoice.charges.' + (lerian_recurring && lerian_usage ? 'subscription_and_usage' : (lerian_recurring ? 'subscription' : 'usage')))
              span.period-dates = [billing_period.from_datetime, billing_period.to_datetime].compact.map { |t| I18n.l(t.in_time_zone(customer.applicable_timezone).to_date, format: :default) }.join(' – ')

          / 1. Subscription fee (if present in this period)
          - if fee_group.subscription_fee && FeeDisplayHelper.should_display_subscription_fee?(invoice_subscription)
            - subscription_fee = fee_group.subscription_fee
            tr.fee
              - if subscription_fee.invoice_display_name.present?
                td.body-1 = subscription_fee.invoice_display_name
              - else
                td.body-1 = I18n.t('invoice.subscription_interval', plan_interval: I18n.t("invoice.#{subscription.plan.interval}"), plan_name: subscription.plan.invoice_name)
              td.body-2 = subscription_fee&.units || 1
              td.body-2 == MoneyHelper.cell((MoneyHelper.format(subscription_fee&.unit_amount || 0)))
              td.body-2 == TaxHelper.applied_taxes(subscription_fee)
              td.body-2 == MoneyHelper.cell((MoneyHelper.format(subscription_fee.amount)))

          / 2. Fixed charge fees (alphabetically ordered, already filtered for positive units)
          - fee_group.fixed_charge_fees.each do |fee|
            == SlimHelper.render('templates/invoices/v4/_fixed_charge_fee', fee)

          / 3. Charge fees (alphabetically ordered, already filtered for positive units and no true-up parent)
          - fee_group.charge_fees.group_by(&:charge_id).each do |_charge_id, fees|
            / Fees for filters
            - if fees.all? { |f| f.charge_filter_id? } && fees.sum(&:units) > 0
              - fees.each do |fee|
                - if fee.amount_details.blank?
                  == SlimHelper.render('templates/invoices/v4/_default_fee_with_filters', fee)
                - else
                  == SlimHelper.render('templates/invoices/v4/_fee_with_filters', fee)

              / True up fees attached to the fee
              - fees.select { |f| f.true_up_fee.present? }.each do |fee|
                == SlimHelper.render('templates/invoices/v4/_true_up_fee', fee)

            / Fees without filters
            - else
              - fees.each do |fee|
                == SlimHelper.render('templates/invoices/v4/_fees_without_filters', fee)

          / 4. Minimum commitment fee (if present in this period)
          - if fee_group.commitment_fee
            - commitment_fee = fee_group.commitment_fee
            tr.fee
              td.body-1 = commitment_fee.invoice_name
              td.body-2 = 1
              td.body-2 == MoneyHelper.cell((MoneyHelper.format(commitment_fee.amount)))
              td.body-2 == TaxHelper.applied_taxes(commitment_fee)
              td.body-2 == MoneyHelper.cell((MoneyHelper.format(commitment_fee.amount)))

    /! lerian:total
    / Total section
    .invoice-resume.overflow-auto
      table.total-table width="100%"
        - if subscriptions.count == 1
          - unless credit?
            - if progressive_billing_credit_amount_cents.positive?
              tr
                td.body-2
                td.body-2 = I18n.t('invoice.progressive_billing_credit')
                td.body-2 == MoneyHelper.cell((MoneyHelper.format(progressive_billing_credit_amount)), '-')

            - if coupons_amount_cents.positive?
              - credits.coupon_kind.order(created_at: :asc).each do |credit|
                tr
                  td.body-2
                  td.body-2 #{credit.invoice_coupon_display_name}
                  td.body-2 == MoneyHelper.cell((MoneyHelper.format(credit.amount)), '-')
          tr
            td.body-2
            td.body-2 = I18n.t('invoice.sub_total_without_tax')
            td.body-2 == MoneyHelper.cell((MoneyHelper.format(sub_total_excluding_taxes_amount)))
          - if applied_taxes.present?
            - applied_taxes.order(tax_rate: :desc).each do |applied_tax|
              tr
                td.body-2
                - if applied_tax.applied_on_whole_invoice?
                  td.body-2 = I18n.t('invoice.tax_name_only.' + applied_tax.tax_code)
                  td.body-2
                - else
                  td.body-2 = I18n.t('invoice.tax_name', name: applied_tax.tax_name, rate: applied_tax.tax_rate, amount: MoneyHelper.format(applied_tax.taxable_amount))
                  td.body-2 == MoneyHelper.cell((MoneyHelper.format(applied_tax.amount)))
          - else
            tr
              td.body-2
              td.body-2 = I18n.t('invoice.tax_name_with_details', name: 'Tax', rate: 0)
              td.body-2 == MoneyHelper.cell((MoneyHelper.format(0.to_money(currency))))
          tr
            td.body-2
            td.body-2 = I18n.t('invoice.sub_total_with_tax')
            td.body-2 == MoneyHelper.cell((MoneyHelper.format(sub_total_including_taxes_amount)))
          - if credits.credit_note_kind.any?
            tr
              td.body-2
              td.body-2 = I18n.t('invoice.credit_notes')
              td.body-2 == MoneyHelper.cell((MoneyHelper.format(credit_notes_amount)), '-')
          == SlimHelper.render('templates/invoices/v4/_prepaid_credits', self)
          tr
            td.body-2
            td.body-1 = I18n.t('invoice.total')
            td.body-1
              == MoneyHelper.cell(total_amount, code: true)
        - else
          - if progressive_billing_credit_amount_cents.positive?
            - credits = progressive_billing_credits_for_subscription(invoice_subscription.subscription).all
            - if credits.present?
              tr
                td.body-2
                td.body-2 = I18n.t('invoice.progressive_billing_credit')
                td.body-2 == MoneyHelper.cell((MoneyHelper.format(credits.sum(&:amount))), '-')
          tr
            td.body-2
            td.body-1 = I18n.t('invoice.total')
            td.body-1
              == MoneyHelper.cell(invoice_subscription.total_amount, code: true)

    / Lerian: the recurring fees breakdown, as the usage-by-day appendix (rows grouped by date, action and
    / duration with the amounts summed, never one row per item; split in two columns; presentation only)
    /! lerian:appendix
    - if grouped_fees.any? { |fg| fg.charge_fees.any? }
      - recurring_fees(subscription.id).group_by(&:charge_id).each do |_charge_id, fees|
        - next unless fees.sum(&:units) > 0

        - number_of_days_in_period = 30
        - lerian_tables = fees.all? { |f| f.charge_filter_id? } ? fees.select { |f| f.units.positive? }.map { |f| ["#{fees.first.invoice_name} • #{f.filter_display_name(separator: ' • ')}", [f]] } : [[fees.first.invoice_name, fees]]
        - billing_period = FeeBoundariesHelper.billing_period_for(fees.first, invoice_subscription:)
        - lerian_period = [billing_period.from_datetime, billing_period.to_datetime].compact.map { |t| I18n.l(t.in_time_zone(customer.applicable_timezone).to_date, format: :default) }.join(' – ')
        - lerian_tables.each do |title, table_fees|
          - rows = []
          - table_fees.each do |fee|
            - breakdowns = recurring_breakdown(fee)
            - number_of_days_in_period = breakdowns.last.total_duration if breakdowns.any?
            - breakdowns.group_by { |b| [b.date, b.action, b.duration, b.total_duration] }.each_value do |items|
              - rows << [items.first, items.sum(&:amount)]
          - next if rows.empty?
          - half = (rows.size + 1) / 2
          - columns = [rows.first(half), rows.drop(half)].reject(&:empty?)
          .appendix-block
            .appendix-title = title
            p.appendix-intro = I18n.t('lerian.invoice.appendix.intro', item: fees.first.item_name, period: lerian_period) + ' ' + I18n.t(fees.first.charge.prorated? ? 'lerian.invoice.appendix.prorated' : 'lerian.invoice.appendix.not_prorated')
            .appendix-cols
              - columns.each_with_index do |column, column_index|
                table.appendix-table
                  tr.first_child
                    td = I18n.t('lerian.invoice.appendix.date')
                    td = I18n.t('lerian.invoice.appendix.days_active')
                    td = fees.first.item_name
                  - column.each do |breakdown, group_amount|
                    tr
                      td = I18n.l(breakdown.date, format: :default)
                      td = "#{breakdown.duration} / #{breakdown.total_duration}"
                      td
                        - if breakdown.action.to_sym == :add
                          | #{group_amount}
                        - elsif breakdown.action.to_sym == :remove
                          | #{group_amount.negative? ? '' : '-'}#{group_amount}
                        - else
                          | +/-#{group_amount}
                  - if column_index == columns.size - 1
                    tr.total-row
                      td = I18n.t('lerian.invoice.appendix.total')
                      td
                      td = RoundingHelper.round_decimal_part(table_fees.sum(&:units))

        /! lerian:notice
        - if fees.first.charge.prorated?
          p.notice = I18n.t('invoice.notice_prorated', days_in_month: number_of_days_in_period)
        - else
          p.notice = I18n.t('invoice.notice_full')
        /! lerian:notice-end

    /! lerian:presentation
    - unless disable_presentation_breakdowns
      == SlimHelper.render('templates/invoices/v4/_presentation_breakdowns', self, fees: filtered_fees)
