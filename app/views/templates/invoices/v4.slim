doctype html
html
  head
    meta charset='UTF-8'
    meta http-equiv='X-UA-Compatible' content='IE=edge'
    meta name='viewport' content='width=device-width, initial-scale=1.0'
    title Invoice
  body
    css:
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url(data:font/woff2;base64,) format('woff2');
      }
      @font-face {
        font-family: 'IBM Plex Mono';
        font-style: normal;
        font-weight: 400;
        src: url(data:font/woff2;base64,) format('woff2');
      }
      @font-face {
        font-family: 'IBM Plex Mono';
        font-style: normal;
        font-weight: 600;
        src: url(data:font/woff2;base64,) format('woff2');
      }

      :root {
        --border-color: #E4E4E7;
        --ink: #18181B;
        --muted: #71717A;
        --head: #F4F4F5;
        --chip: #E4E4E7;
        --accent: #FACC15;
        --mono: 'IBM Plex Mono', 'DejaVu Sans Mono', ui-monospace, Menlo, monospace;
      }
      h1, h2, p { margin: 0; padding: 0; }
      html { font-family: Inter, sans-serif; color: var(--ink); }
      body { padding-bottom: 0; }
      h1 { color: var(--ink); font-weight: 700; font-size: 26px; line-height: 32px; letter-spacing: -0.3px; }
      h2 {
        color: var(--ink);
        font-weight: 700;
        font-size: 18px;
        line-height: 24px;
      }
      .body-1 {
        color: var(--muted);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-size: 10px;
        line-height: 16px;
      }
      .body-2 {
        color: var(--ink);
        font-weight: 400;
        font-size: 10px;
        line-height: 16px;
      }
      .body-3 {
        color: var(--muted);
        font-weight: 400;
        font-size: 9px;
        line-height: 16px;
      }

      .mb-4 {
        margin-bottom: 4px;
      }
      .mb-24 {
        margin-bottom: 24px;
      }
      .mt-24 {
        margin-top: 24px;
      }

      .overflow-auto {
        overflow: auto;
      }
      tr {
        break-inside: avoid;
      }

      .invoice-title {
        display: inline;
      }
      .header-logo {
        float: right;
        max-height: 32px;
      }

      .invoice-information-column {
        float: left;
        width: 50%;
      }
      .invoice-information-table tr td:first-child {
        padding: 0 16px 0 0;
        white-space: nowrap;
        width: 1%;
      }
      .invoice-information-table tr td:last-child {
        width: 55%;
      }
      .invoice-information-table, tr td {
        text-wrap: normal;
        word-wrap: break-word;
        vertical-align: top;
      }
      .invoice-information-table {
        border-collapse: collapse;
        width: 100%;
      }

      .billing-information-column {
        float: left;
        width: 50%;
      }

      .invoice-resume-table tr td {
        padding-top: 4px;
        padding-bottom: 4px;
        text-align: right;
        word-wrap: break-word;
      }
      .invoice-resume-table td:first-child {
        width: 48%;
        text-align: left;
      }
      .invoice-resume-table td:nth-child(2) {
        width: 14.5%;
        max-width: 10vw;
      }
      .invoice-resume-table td:nth-child(3) {
        width: 12.5%;
        max-width: 10vw;
      }
      .invoice-resume-table td:nth-child(4) {
        width: 12.5%;
      }
      .invoice-resume-table td:nth-child(5) {
        width: 12.5%;
        max-width: 10vw;
      }

      .invoice-resume-table tr.first_child td {
        color: var(--muted);
      }

      .invoice-resume-table tr.charge-name td {
        padding-bottom: 0;
        color: var(--ink);
      }

      .invoice-resume-table tr.details td {
        color: var(--muted);
        padding-top: 4px;
        padding-bottom: 4px;
      }

      .invoice-resume-table tr.details td:first-child {
        padding-left: 8px;
      }

      .invoice-resume-table tr.details.subtotal td {
        color: var(--ink);
      }

      .invoice-resume-table tr.fee:first-child {
        border-top: none;
      }
      /* Each first tr representing fee draws border above it */
      .invoice-resume-table tr.fee {
        border-top: 1px solid var(--border-color);
      }
      .invoice-resume-table tr:last-child {
        border-bottom: 1px solid var(--border-color);
      }

      .invoice-resume-table tr.fee td {
        padding-top: 8px;
      }
      /* If tr has next element tr.fee means that current fee info ended and we need bigger padding */
      .invoice-resume-table tr:has(+ tr.fee) td {
        padding-bottom: 8px;
      }
      .invoice-resume-table tr:last-child td {
        padding-bottom: 8px;
      }

      .invoice-resume table {
        border-collapse: collapse;
      }
      .invoice-resume .total-table tr td {
        padding-top: 8px;
        padding-bottom: 8px;
        text-align: right;
      }
      .invoice-resume .total-table td:first-child {
        width: 50%;
      }
      .invoice-resume .total-table tr:not(:last-child) td:nth-child(2) {
        border-bottom: 1px solid var(--border-color);
        text-align: left;
        width: 35%;
      }
      .invoice-resume .total-table tr:not(:last-child) td:nth-child(3) {
        border-bottom: 1px solid var(--border-color);
        text-align: right;
        width: 15%;
      }
      .invoice-resume .total-table tr:last-child td:nth-child(2) {
        text-align: left;
        width: 25%;
      }
      .invoice-resume .total-table tr:last-child td:nth-child(3) {
        text-align: right;
        width: 25%;
      }

      .invoice-details-title {
        page-break-before: always;
      }

      .breakdown-details table {
        border-collapse: collapse;
      }
      .breakdown-details {
        margin-top: -15px;
      }
      .breakdown-details-table tr td {
        padding-bottom: 8px;
        padding-top: 8px;
      }
      .breakdown-details-table tr td:last-child {
        text-align: right;
      }
      .breakdown-details-table tr td {
        border-bottom: 1px solid var(--border-color);
      }
      .breakdown-details-table tr:first-child td {
        border-top: 1px solid var(--border-color);
      }
      .breakdown-details.presentation-breakdowns {
        overflow: visible;
      }
      .presentation-breakdowns-page {
        page-break-before: always;
        padding-top: 24px;
      }
      .presentation-breakdowns .breakdown-details-table tr td {
        border-bottom: none;
        border-top: none;
        color: var(--muted);
        padding-bottom: 8px;
        padding-top: 0;
      }
      .presentation-breakdowns .breakdown-details-table tr.fee td {
        color: var(--ink);
        padding-bottom: 6px;
        padding-top: 8px;
      }
      .presentation-breakdowns .breakdown-details-table tr.section-end td {
        border-bottom: 1px solid #d9dee7;
        padding-bottom: 8px;
      }
      .presentation-breakdowns .breakdown-details-table tr.presentation-group td:first-child {
        padding-left: 8px;
      }

      .powered-by {
        width: 100%;
        text-align: right;
      }
      .powered-by span {
        color: #8c95a6;
      }
      .powered-by img {
        width: 37px;
        height: 11px;
        vertical-align: middle;
        margin-top: 2px;
      }

      .brand-card { display: flex; align-items: center; justify-content: space-between; border: 1px solid var(--border-color); border-radius: 8px; padding: 6px 16px; margin-bottom: 10px; }
      .brand-card img { height: 18px; }
      .brand-card .doc-kind { font-family: var(--mono); font-size: 9px; font-weight: 600; letter-spacing: 1.2px; text-transform: uppercase; color: var(--muted); }
      .doc-title { margin-bottom: 6px; }
      .body-1, .body-2 { line-height: 14px !important; }
      .body-3 { line-height: 13px !important; }
      .invoice-resume-table tr td { padding-top: 3px; padding-bottom: 3px; }
      .mb-24 { margin-bottom: 10px; }
      /* gap between billing-period groups (upstream 24px); kept tight so two-period invoices fit one page */
      .mt-24 { margin-top: 14px; }
      .chips { display: flex; gap: 8px; margin-bottom: 10px; }
      .chip { display: inline-block; font-family: var(--mono); font-size: 8.5px; font-weight: 500; letter-spacing: 0.3px; line-height: 14px; padding: 2px 8px; border-radius: 4px; background: var(--chip); color: var(--ink); }
      .chip.dark { background: #27272A; color: #FFFFFF; }
      .chip.accent { background: var(--accent); color: var(--ink); }
      .invoice-information-table tr td:first-child { color: var(--muted); }
      .invoice-information-table tr td:last-child { font-family: var(--mono); font-size: 10px; }
      .amount-due { display: flex; align-items: baseline; gap: 14px; padding: 6px 16px; background: var(--head); border-radius: 8px; }
      .amount-due .title-2 { font-size: 22px; font-weight: 600; font-variant-numeric: tabular-nums; }
      .invoice-resume-table tr.first_child td, .invoice-resume-table tr:first-child td { background: var(--head); color: var(--muted); font-weight: 600; font-size: 8.5px; text-transform: uppercase; letter-spacing: 0.6px; padding: 6px 12px; border-bottom: 1px solid var(--accent); font-family: Inter, sans-serif; white-space: normal; line-height: 12px; }
      .invoice-resume-table tr td { padding-left: 12px; padding-right: 12px; }
      .invoice-resume-table td:not(:first-child) { font-family: var(--mono); font-size: 10px; font-variant-numeric: tabular-nums; white-space: nowrap; }
      .invoice-resume .total-table td:nth-child(3) { font-family: var(--mono); font-size: 10px; font-variant-numeric: tabular-nums; white-space: nowrap; }
      .invoice-resume .total-table tr:last-child td { font-size: 12px; font-weight: 700; }
      .invoice-resume .total-table tr:last-child td:nth-child(3) { font-family: var(--mono); font-weight: 600; font-size: 10px; }
      .money { display: inline-grid; grid-template-columns: auto minmax(11ch, auto); column-gap: 5px; white-space: nowrap; }
      .money .cur { text-align: left; }
      .money .num { text-align: right; font-variant-numeric: tabular-nums; }
      .amount-due .money { grid-template-columns: auto auto; column-gap: 8px; }
      /* own bottom margin, so the payment block keeps the lerian.4 spacing whatever follows it */
      .payment-block { break-inside: avoid; margin-bottom: 8px; }
      /* tables: plain ink inside cells, body-1 muted/uppercase is for section labels only */
      .invoice-resume-table td.body-1, .invoice-resume-table td .body-1, .total-table td.body-1, .invoice-resume-table tr.charge-name td, .breakdown-details-table td.body-1, .breakdown-details-table td .body-1 { color: var(--ink); text-transform: none; letter-spacing: 0; font-weight: 500; }
      .invoice-resume-table td, .total-table td { vertical-align: middle; }
      /* 5-column fee tables: widths that fit the mono amounts without clipping (upstream caps cols at 10vw) */
      .invoice-resume-table { table-layout: fixed; width: 100%; }
      .invoice-resume-table td:first-child { width: 38%; }
      .invoice-resume-table td:first-child:nth-last-child(2) { width: 70%; }
      .invoice-resume-table td:nth-child(2):nth-last-child(1) { width: 30%; }
      .invoice-resume-table td:nth-child(2) { width: 8%; max-width: none; }
      .invoice-resume-table td:nth-child(3) { width: 19%; max-width: none; }
      .invoice-resume-table td:nth-child(4) { width: 16%; }
      .invoice-resume-table td:nth-child(5) { width: 19%; max-width: none; }
      /* one_off.slim sets `tr td:last-child { width: 18% }` (higher specificity): keep the 5th column at 19% so every root shares one grid */
      .invoice-resume-table tr td:nth-child(5):last-child { width: 19%; }
      .invoice-resume-table td:not(:first-child) { padding-left: 8px; padding-right: 8px; }
      .invoice-resume-table td:last-child { padding-right: 12px; }
      .invoice-resume-table:has(td:nth-child(5)) { width: calc(100% - 1px); }
      .invoice-resume-table tr.first_child td, .invoice-resume-table tr:first-child td { white-space: nowrap; letter-spacing: 0.3px; vertical-align: middle; }
      .invoice-resume-table tr.first_child td:not(:first-child), .invoice-resume-table tr:first-child td:not(:first-child) { padding-left: 8px; padding-right: 8px; }
      .invoice-resume-table tr.first_child td:last-child, .invoice-resume-table tr:first-child td:last-child { padding-right: 12px; }
      /* totals block: same right edge and padding as the tables above it */
      .invoice-resume .total-table td:nth-child(3) { padding-right: 12px; }
      .invoice-resume .total-table td:nth-child(2) { padding-left: 12px; }
      .invoice-resume .total-table tr:last-child td { color: var(--ink); }
      .invoice-resume .total-table tr td { padding-top: 5px; padding-bottom: 5px; }
      .payment-detail { white-space: pre-line; }
      .alert {
        display: flex;
        flex-direction: row;
        align-items: center;
        padding: 16px;
        gap: 16px;
        background: #F3F4F6;
        border-radius: 12px;
      }

    .wrapper
      .brand-card
        - if billing_entity.logo.present?
          img src="data:#{billing_entity.logo.content_type};base64,#{billing_entity.base64_logo}"
        - else
          img src="data:image/png;base64," alt="Lerian"
        .doc-kind = document_invoice_name
      h1.doc-title = number
      - pt = I18n.locale.to_s.start_with?('pt')
      - status_label = status.to_s == 'voided' ? (pt ? 'Cancelada' : 'Voided') : ({pending: (pt ? 'Pendente' : 'Pending'), succeeded: (pt ? 'Pago' : 'Paid'), failed: (pt ? 'Falhou' : 'Failed')}[payment_status.to_s.to_sym] || payment_status.to_s)
      .chips
        span.chip.dark = status_label
        span.chip = I18n.l(issuing_date, format: :default)
        span.chip.accent = I18n.t('invoice.due_date', date: I18n.l(payment_due_date, format: :default))

      .mb-24.overflow-auto
        .invoice-information-column
          table.invoice-information-table
            tr
              td.body-1 = I18n.t('invoice.invoice_number')
              td.body-2 = number
            - if purchase_order_number.present?
              tr
                td.body-1 = I18n.t('invoice.purchase_order_number')
                td.body-2 = purchase_order_number
            tr
              td.body-1 = I18n.t('invoice.issue_date')
              td.body-2 = I18n.l(issuing_date, format: :default)
            tr
              td.body-1 = I18n.t('invoice.payment_term')
              td.body-2 = I18n.t('invoice.payment_term_days', net_payment_term:)
        .invoice-information-column
          table.invoice-information-table
            - if customer.metadata.displayable.any?
              - customer.metadata.displayable.order(created_at: :asc).each do |metadata|
                tr
                  td.body-1 = metadata.key
                  td.body-2 = metadata.value

      .mb-24.overflow-auto
        .billing-information-column
          .body-1 = I18n.t('invoice.bill_from')
          .body-2
            - if billing_entity.legal_name.present?
              | #{billing_entity.legal_name}
            - else
              | #{billing_entity.name}
          - if billing_entity.legal_number.present?
            .body-2 #{billing_entity.legal_number}
          .body-2 = billing_entity.address_line1
          .body-2 = billing_entity.address_line2
          .body-2
            span
              = billing_entity.zipcode
            - if billing_entity.zipcode.present? && billing_entity.city.present?
              span
                | , &nbsp;
            span
              = billing_entity.city
          - if billing_entity.state.present?
            .body-2 = billing_entity.state
          .body-2 = ISO3166::Country.new(billing_entity.country)&.common_name
          .body-2 = billing_entity.email
          - if billing_entity.tax_identification_number.present?
            .body-2 = I18n.t('invoice.tax_identification_number', tax_identification_number: billing_entity.tax_identification_number)
        .billing-information-column
          .body-1 = I18n.t('invoice.bill_to')
          .body-2 = customer.display_name
          - if customer.legal_number.present?
            .body-2 #{customer.legal_number}
          == SlimHelper.render('templates/invoices/v4/_customer_address', self)
          .body-2 = customer.email&.gsub(/,\s*/, ', ')
          - if customer.tax_identification_number.present?
            .body-2 = I18n.t('invoice.tax_identification_number', tax_identification_number: customer.tax_identification_number)

      .mb-24.amount-due
        .body-1 = I18n.t('invoice.total')
        h2.title-2 == MoneyHelper.cell(total_amount)

      .invoice-resume.mb-24.overflow-auto
        - if credit?
          == SlimHelper.render('templates/invoices/v4/_credit', self)
        - elsif progressive_billing?
          == SlimHelper.render('templates/invoices/v4/_progressive_billing_details', self)
        - elsif subscriptions.count == 1
          == SlimHelper.render('templates/invoices/v4/_subscription_details', self, disable_presentation_breakdowns: false)
        - else
          == SlimHelper.render('templates/invoices/v4/_subscriptions_summary', self)

      == SlimHelper.render('templates/invoices/v4/_eu_tax_management', self)

      - applied_usage_threshold = progressive_billing_last_applied_usage_threshold
      - if applied_usage_threshold
        p.body-3.mb-24
          = I18n.t('invoice.reached_usage_threshold', usage_amount: MoneyHelper.format(applied_usage_threshold.lifetime_usage_amount), threshold_amount: MoneyHelper.format(applied_usage_threshold.passed_threshold_amount))

      - if applied_invoice_custom_sections.present?
        == SlimHelper.render('templates/invoices/v4/_custom_sections', self)

      - if billing_entity.invoice_footer.present?
        .mb-24.payment-block
          p.body-1.mb-4 = I18n.locale.to_s.start_with?('pt') ? 'Dados de pagamento' : 'Payment detail'
          p.body-2.payment-detail = LineBreakHelper.break_lines(billing_entity.invoice_footer)

      - if subscriptions.length > 1
        == SlimHelper.render('templates/invoices/v4/_subscription_details', self, disable_presentation_breakdowns: false)
