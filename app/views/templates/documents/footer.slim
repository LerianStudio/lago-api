doctype html
- page_numbering = I18n.t("document.page_numbering", current: '<span class="pageNumber"></span>', total: '<span class="totalPages"></span>')
- entity = billing_entity if respond_to?(:billing_entity)
html
  head
    meta charset="UTF-8"
    style
      | @font-face {
          font-family: 'Inter';
          font-style: normal;
          font-weight: 400;
          font-display: swap;
          src: local("Inter"), local("Inter-Regular"), url(data:font/woff2;base64,) format('woff2');
        }
        @font-face {
          font-family: 'Inter';
          font-style: normal;
          font-weight: 500;
          font-display: swap;
          src: local("Inter Medium"), local("Inter-Medium"), url(data:font/woff2;base64,) format('woff2');
        }

        body {
          box-sizing: border-box;
          margin: 0;
          padding: 0 calc(0.42in + 15.36px);
          color: #6E6E77;
          print-color-adjust: exact;
          -webkit-print-color-adjust: exact;
          font-family: Inter, sans-serif;
          font-size: 11.52px;
          line-height: 15.36px;
        }

        .footer {
          box-sizing: border-box;
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 15.36px;
          width: 100%;
          border-top: 1px solid #E4E4E7;
          padding: 10.24px 0 15.36px;
          font-variant-numeric: tabular-nums;
        }

        .brand { display: flex; align-items: center; gap: 10.24px; min-width: 0; }
        .brand img { display: block; height: 15.36px; flex: none; }
        .entity { min-width: 0; font-family: Inter, sans-serif; font-size: 11.52px; line-height: 15.36px; font-weight: 400; color: #6E6E77; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .meta { flex: none; font-family: Inter, sans-serif; font-size: 11.52px; line-height: 15.36px; font-weight: 400; color: #6E6E77; text-align: right; white-space: nowrap; }
        .meta b { font-family: Inter, sans-serif; font-size: 11.52px; line-height: 15.36px; font-weight: 500; color: #3F3F46; }
        .pageNumber, .totalPages { font-family: Inter, sans-serif; font-size: 11.52px; line-height: 15.36px; color: #6E6E77; }
  body
    .footer
      .brand
        img src="data:image/png;base64," alt="Lerian"
        - if entity
          .entity = [entity.legal_name.presence || entity.name, entity.email.presence || 'lerian.studio'].join(" · ")
      .meta
        b = number
        = " · "
        == page_numbering
